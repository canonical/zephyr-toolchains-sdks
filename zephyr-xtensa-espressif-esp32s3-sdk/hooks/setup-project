# Make the bundled hal_espressif module discoverable by Zephyr's build system.
# The zephyr base SDK exports ZEPHYR_MODULES=/home/workshop/modules, but Zephyr
# does not recurse into it, so the hal/espressif module root would not be found.
# ZEPHYR_EXTRA_MODULES adds the module root explicitly. Prefer the mounted
# location (modules slot connected to zephyr:modules); fall back to this SDK's
# own copy so firmware builds even without the modules connection.
if [ -d /home/workshop/modules/hal/espressif ]; then
  HAL_ESPRESSIF=/home/workshop/modules/hal/espressif
elif [ -d "$SDK/modules/hal/espressif" ]; then
  HAL_ESPRESSIF="$SDK/modules/hal/espressif"
fi
if [ -n "${HAL_ESPRESSIF:-}" ]; then
  cat <<EOF >> ~/.profile
export ZEPHYR_EXTRA_MODULES=$HAL_ESPRESSIF
EOF
fi
